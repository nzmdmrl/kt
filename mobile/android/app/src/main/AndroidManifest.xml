<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        YEDEKLEME KAPALI.

        Neden: oturum jetonu (kt_token) WebView'ın localStorage'ında duruyor, o da
        uygulamanın veri dizininin içinde. Android Auto Backup varsayılan olarak bu
        dizini buluta yedekliyordu; uygulama silinip yeniden kurulunca sistem veriyi
        GERİ YÜKLÜYOR ve kullanıcı hiç giriş yapmadan giriş yapmış olarak açılıyordu.
        ("Verileri temizle" farklı davranıyordu, çünkü geri yükleme yalnızca KURULUM
        anında çalışır — teşhiste bu doğrulandı.)

        Üç öznitelik birden gerekiyor, çünkü tek başına allowBackup her sürümü
        kapsamıyor:
          allowBackup=false      -> buluta yedeklemeyi kapatır (tüm sürümler)
          fullBackupContent      -> Android 11 ve altı için kural dosyası
          dataExtractionRules    -> Android 12+ ; bulut yedeği VE cihazdan cihaza
                                    aktarımı ayrı ayrı kapsar. Android 12+'ta
                                    cihazdan cihaza aktarım allowBackup'a BAKMAZ,
                                    yalnızca bu dosyayla dışlanır.
        Her iki dosya da "her şeyi hariç tut" der (res/xml/).
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                ANDROID APP LINKS — disaridan gelen kelimetahmin.com linkleri
                TARAYICI yerine UYGULAMADA acilir.

                android:autoVerify="true": Android, kurulumdan sonra
                https://<host>/.well-known/assetlinks.json dosyasini indirir ve
                icindeki paket adi + SHA-256 parmak izi bu uygulamayla tutuyorsa
                linkleri sessizce uygulamaya baglar (kullaniciya "hangisiyle
                acilsin" diye sorulmaz).

                NEDEN SADECE www: dogrulama sirasinda Android yonlendirme
                IZLEMEZ. Apex (kelimetahmin.com) her istegi www'ye 301 atiyor,
                dolayisiyla orada assetlinks.json dogrudan 200 DONEMEZ ve o host
                asla dogrulanamaz. Apex'i beyan etmek dogrulanmamis bir host
                birakirdi; yazmiyoruz.
                Pratikte kayip yok: uygulamanin ve sitenin urettigi TUM paylasim
                linkleri window.location.origin'den gelir, o da www'dur
                (frontend/lib/shareText.ts, RoomInvite, arena daveti).
                Elle "kelimetahmin.com/..." yazan biri tarayicida acar.

                YOL LISTESI — hepsi degil, SECILI yollar. Disarida birakilanlar
                bilerek tarayicida acilir:
                  /hesap-silme  -> Google Play politikasi bu adresin uygulama
                                   OLMADAN da acilabilmesini istiyor,
                  /gizlilik /kosullar /cerez /iletisim /hakkimizda
                  /nasil-oynanir -> yasal ve tanitim sayfalari,
                  /yonetim      -> yonetim paneli (masaustu icin),
                  /giris        -> paylasilan bir adres degil.
                Yeni bir yol eklemek gerekirse buraya bir <data> satiri yazmak
                ve yeni AAB yayinlamak yeterli (assetlinks.json degismez).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="www.kelimetahmin.com" />

                <!-- Ana sayfa (yalniz tam eslesme; pathPrefix "/" her seyi kapardi) -->
                <data android:path="/" />

                <!-- Oyun ve davet baglantilari -->
                <data android:pathPrefix="/oda" />
                <data android:pathPrefix="/oyna" />
                <data android:pathPrefix="/arena" />
                <data android:pathPrefix="/solo" />
                <data android:pathPrefix="/gunun-kelimesi" />

                <!-- Sosyal ve kisisel sayfalar -->
                <data android:pathPrefix="/profil" />
                <data android:pathPrefix="/lig" />
                <data android:pathPrefix="/arkadaslar" />
                <data android:pathPrefix="/uye-ara" />
                <data android:pathPrefix="/bildirimler" />
                <data android:pathPrefix="/gecmis" />
                <data android:pathPrefix="/duyurular" />

                <!-- Hesap akislari -->
                <data android:pathPrefix="/dogrula" />
                <data android:pathPrefix="/destek" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Bildirim ikonu: bunlar tanımlı DEĞİLKEN Android launcher ikonuna
             düşüyor ve durum çubuğunda beyaz leke çiziyordu. Siluet
             @drawable/ic_stat_notify, tint rengi @color/notification_color. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sesli tahmin (@capacitor-community/speech-recognition). İzin uygulama
         açılışında DEĞİL, kullanıcı mikrofona ilk kez basınca istenir. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ paket görünürlüğü: bu blok OLMADAN sistemdeki tanıma servisi
         uygulamaya görünmez, SpeechRecognizer.isRecognitionAvailable() false döner
         ve mikrofon düğmesi hiç çıkmaz. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
