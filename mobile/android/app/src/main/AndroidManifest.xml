<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        YEDEKLEME KAPALI.

        Neden: oturum jetonu (kt_token) WebView'ın localStorage'ında duruyor, o da
        uygulamanın veri dizininin içinde. Android Auto Backup varsayılan olarak bu
        dizini buluta yedekliyordu; uygulama silinip yeniden kurulunca sistem veriyi
        GERİ YÜKLÜYOR ve kullanıcı hiç giriş yapmadan giriş yapmış olarak açılıyordu.
        ("Verileri temizle" farklı davranıyordu, çünkü geri yükleme yalnızca KURULUM
        anında çalışır — teşhiste bu doğrulandı.)

        Üç öznitelik birden gerekiyor, çünkü tek başına allowBackup her sürümü
        kapsamıyor:
          allowBackup=false      -> buluta yedeklemeyi kapatır (tüm sürümler)
          fullBackupContent      -> Android 11 ve altı için kural dosyası
          dataExtractionRules    -> Android 12+ ; bulut yedeği VE cihazdan cihaza
                                    aktarımı ayrı ayrı kapsar. Android 12+'ta
                                    cihazdan cihaza aktarım allowBackup'a BAKMAZ,
                                    yalnızca bu dosyayla dışlanır.
        Her iki dosya da "her şeyi hariç tut" der (res/xml/).
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Bildirim ikonu: bunlar tanımlı DEĞİLKEN Android launcher ikonuna
             düşüyor ve durum çubuğunda beyaz leke çiziyordu. Siluet
             @drawable/ic_stat_notify, tint rengi @color/notification_color. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sesli tahmin (@capacitor-community/speech-recognition). İzin uygulama
         açılışında DEĞİL, kullanıcı mikrofona ilk kez basınca istenir. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ paket görünürlüğü: bu blok OLMADAN sistemdeki tanıma servisi
         uygulamaya görünmez, SpeechRecognizer.isRecognitionAvailable() false döner
         ve mikrofon düğmesi hiç çıkmaz. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
