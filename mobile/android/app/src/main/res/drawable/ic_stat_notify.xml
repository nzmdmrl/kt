<?xml version="1.0" encoding="utf-8"?>
<!--
  Bildirim durum çubuğu ikonu — "K harfi, kelime karesinin içinde".

  KURALLAR (Android bildirim ikonu):
   - Android bu çizimin YALNIZCA ALFA kanalını kullanır; renk sistemden gelir
     (manifest'teki default_notification_color -> @color/notification_color).
     Bu yüzden burada tek renk vardır: beyaz. Gradyan, gri ton, ikinci renk YOK.
   - Doluluk değil SİLUET okunmalı: kare, kalın bir çerçeve (kontur) olarak
     çizilir, K de içeride serbest durur. Dolu kare olsaydı 24dp'de beyaz leke
     gibi görünürdü — düzeltilmek istenen sorun tam olarak buydu.

  ÖLÇÜLER (24x24 viewport):
   - Çerçeve: 3..21 kutusu, köşe yarıçapı 4, kontur kalınlığı 2
     -> kontur 2..4 ve 20..22 aralığını kaplar, içeride 4..20 boş kalır.
   - K: x 8.2..16.0, y 6.2..17.8 (kontur payı dahil) -> çerçeveye en yakın
     noktada bile ~2 birim boşluk kalır, harf çerçeveye değmez.

  Geometri 24x24 ızgarada piksel piksel örneklenerek denetlendi: kaplı alan
  %32 (dolu kare olsaydı ~%100), gövde ve iki kol ayrı ayrı seçiliyor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Kelime karesi — dolu değil, çerçeve. -->
    <path
        android:pathData="M7,3 H17 A4,4 0 0 1 21,7 V17 A4,4 0 0 1 17,21 H7 A4,4 0 0 1 3,17 V7 A4,4 0 0 1 7,3 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />

    <!-- K — dikey gövde -->
    <path
        android:pathData="M9.2,7.2 V16.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- K — üst kol (sağ üstten gövdenin ortasına) -->
    <path
        android:pathData="M15,7.2 L9.4,12.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- K — alt kol (üst kolun üstünden sağ alta) -->
    <path
        android:pathData="M11.1,10.7 L15,16.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

</vector>
